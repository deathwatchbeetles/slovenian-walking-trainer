    "file": "w01-d02-s01.intro.m4a",
    "dur": 20.52
   },
   "recall": {
    "file": "w01-d02-s01.recall.m4a",
    "dur": 6.67,
    "reveal": 4.13
   }
  },
  "w01-d02-s02": {
