    "reveal": 3.65
   }
  },
  "w01-d02-s10": {
   "sl": "Hvala lepa. Na svidenje!",
   "en": "Thank you very much. Goodbye!",
   "hint": null,
   "note": "Na svidenje is built just like the Russian goodbye. Hvala lepa is literally 'beautiful thanks'.",
