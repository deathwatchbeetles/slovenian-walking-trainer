 "cards": {
  "w01-d01-s01": {
   "sl": "Dober dan!",
   "en": "Hello, good day.",
   "hint": null,
   "note": null,
   "intro": {
    "file": "w01-d01-s01.intro.m4a",
    "dur": 10.2
   },
   "recall": {
    "file": "w01-d01-s01.recall.m4a",
    "dur": 6.94,
    "reveal": 4.36
   }
  },
  "w01-d01-s02": {
   "sl": "Kako ste?",
   "en": "How are you?",
   "hint": "formal",
   "note": "ste is 'you are', formal or plural. Unlike Russian, the verb 'to be' is always said in the present.",
   "intro": {
    "file": "w01-d01-s02.intro.m4a",
    "dur": 18.27
   },
   "recall": {
    "file": "w01-d01-s02.recall.m4a",
    "dur": 6.65,
    "reveal": 4.18
   }
  },
  "w01-d01-s03": {
   "sl": "Dobro, hvala. In vi?",
   "en": "Fine, thank you. And you?",
   "hint": null,
   "note": "'And' is in.",
   "intro": {
    "file": "w01-d01-s03.intro.m4a",
    "dur": 28.19
   },
   "recall": {
    "file": "w01-d01-s03.recall.m4a",
    "dur": 12.02,
    "reveal": 6.87
   }
  },
  "w01-d01-s04": {
   "sl": "Tudi dobro, hvala.",
   "en": "Also fine, thank you.",
   "hint": null,
   "note": null,
   "intro": {
    "file": "w01-d01-s04.intro.m4a",
    "dur": 15.58
   },
   "recall": {
    "file": "w01-d01-s04.recall.m4a",
    "dur": 10.11,
    "reveal": 5.92
   }
  },
  "w01-d01-s05": {
   "sl": "Jaz sem Ana.",
   "en": "I am Ana.",
   "hint": null,
   "note": "Slovenian needs the verb: jaz sem, I am. You can drop jaz, but never sem.",
   "intro": {
    "file": "w01-d01-s05.intro.m4a",
    "dur": 21.11
   },
   "recall": {
    "file": "w01-d01-s05.recall.m4a",
    "dur": 7.11,
    "reveal": 4.08
   }
  },
  "w01-d01-s06": {
   "sl": "Kako vam je ime?",
   "en": "What is your name?",
   "hint": "formal",
   "note": "Literally 'how to you is name'. The little words vam and je always sit in second position.",
   "intro": {
    "file": "w01-d01-s06.intro.m4a",
    "dur": 26.14
   },
   "recall": {
    "file": "w01-d01-s06.recall.m4a",
    "dur": 7.97,
    "reveal": 4.95
   }
  },
  "w01-d01-s07": {
   "sl": "Ime mi je Marko.",
   "en": "My name is Marko.",
   "hint": null,
   "note": null,
   "intro": {
    "file": "w01-d01-s07.intro.m4a",
    "dur": 14.77
   },
   "recall": {
    "file": "w01-d01-s07.recall.m4a",
    "dur": 7.83,
    "reveal": 4.61
   }
  },
  "w01-d01-s08": {
   "sl": "Me veseli.",
   "en": "Pleased to meet you.",
   "hint": null,
   "note": "Literally 'it gladdens me'.",
   "intro": {
    "file": "w01-d01-s08.intro.m4a",
    "dur": 14.45
   },
   "recall": {
    "file": "w01-d01-s08.recall.m4a",
    "dur": 6.49,
    "reveal": 3.97
   }
  },
  "w01-d01-s09": {
   "sl": "Kje živite?",
   "en": "Where do you live?",
   "hint": "formal",
   "note": null,
   "intro": {
    "file": "w01-d01-s09.intro.m4a",
    "dur": 9.53
   },
   "recall": {
    "file": "w01-d01-s09.recall.m4a",
    "dur": 7.13,
    "reveal": 4.61
   }
  },
  "w01-d01-s10": {
   "sl": "Živim v Ljubljani.",
   "en": "I live in Ljubljana.",
   "hint": null,
   "note": "Locative after v, as in Russian: Ljubljana becomes v Ljubljani.",
   "intro": {
    "file": "w01-d01-s10.intro.m4a",
    "dur": 25.07
   },
   "recall": {
    "file": "w01-d01-s10.recall.m4a",
    "dur": 8.28,
    "reveal": 4.86
   }
  },
  "w01-d02-s01": {
   "sl": "Izvolite?",
   "en": "What can I get you?",
   "hint": null,
   "note": "Izvolite is what staff say to invite your order. It also means 'here you are' when handing something over.",
   "intro": {
    "file": "w01-d02-s01.intro.m4a",
    "dur": 19.33
   },
   "recall": {
    "file": "w01-d02-s01.recall.m4a",
    "dur": 6.65,
    "reveal": 4.11
   }
  },
  "w01-d02-s02": {
   "sl": "Eno kavo, prosim.",
   "en": "One coffee, please.",
   "hint": null,
   "note": "Accusative: ena kava becomes eno kavo.",
   "intro": {
    "file": "w01-d02-s02.intro.m4a",
    "dur": 24.05
   },
   "recall": {
    "file": "w01-d02-s02.recall.m4a",
    "dur": 9.92,
    "reveal": 5.7
   }
  },
  "w01-d02-s03": {
   "sl": "Z mlekom ali brez?",
   "en": "With milk or without?",
   "hint": null,
   "note": "Instrumental after z, as in Russian: z mlekom. And ali means 'or'.",
   "intro": {
    "file": "w01-d02-s03.intro.m4a",
    "dur": 26.43
   },
   "recall": {
    "file": "w01-d02-s03.recall.m4a",
    "dur": 8.78,
    "reveal": 5.0
   }
  },
  "w01-d02-s04": {
   "sl": "Z mlekom, prosim.",
   "en": "With milk, please.",
   "hint": null,
