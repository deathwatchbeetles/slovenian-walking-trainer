 "cards": {
  "w01-d01-s01": {
   "sl": "Dober dan!",
   "en": "Hello, good day.",
   "hint": null,
   "note": null,
   "intro": {
    "file": "w01-d01-s01.intro.m4a",
    "dur": 10.49
   },
   "recall": {
    "file": "w01-d01-s01.recall.m4a",
