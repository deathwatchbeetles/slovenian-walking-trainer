    "reveal": 4.33
   }
  },
  "w01-d01-s02": {
   "sl": "Kako ste?",
   "en": "How are you?",
   "hint": "formal",
   "note": "ste is 'you are', formal or plural. Unlike Russian, the verb 'to be' is always said in the present.",
   "intro": {
    "file": "w01-d01-s02.intro.m4a",
    "dur": 19.71
   },
   "recall": {
    "file": "w01-d01-s02.recall.m4a",
    "dur": 7.08,
    "reveal": 4.59
   }
  },
  "w01-d01-s03": {
   "sl": "Dobro, hvala. In vi?",
   "en": "Fine, thank you. And you?",
   "hint": null,
   "note": "'And' is in.",
   "intro": {
    "file": "w01-d01-s03.intro.m4a",
    "dur": 38.41
   },
   "recall": {
    "file": "w01-d01-s03.recall.m4a",
    "dur": 15.83,
    "reveal": 8.66
   }
  },
  "w01-d01-s04": {
   "sl": "Tudi dobro, hvala.",
   "en": "Also fine, thank you.",
   "hint": null,
   "note": null,
   "intro": {
    "file": "w01-d01-s04.intro.m4a",
    "dur": 17.46
   },
   "recall": {
    "file": "w01-d01-s04.recall.m4a",
    "dur": 10.77,
    "reveal": 6.17
   }
  },
  "w01-d01-s05": {
   "sl": "Jaz sem Ana.",
   "en": "I am Ana.",
   "hint": null,
   "note": "Slovenian needs the verb: jaz sem, I am. You can drop jaz, but never sem.",
   "intro": {
    "file": "w01-d01-s05.intro.m4a",
    "dur": 22.14
   },
   "recall": {
    "file": "w01-d01-s05.recall.m4a",
    "dur": 6.88,
    "reveal": 4.02
   }
  },
  "w01-d01-s06": {
   "sl": "Kako vam je ime?",
   "en": "What is your name?",
   "hint": "formal",
   "note": "Literally 'how to you is name'. The little words vam and je always sit in second position.",
   "intro": {
    "file": "w01-d01-s06.intro.m4a",
    "dur": 28.2
   },
   "recall": {
    "file": "w01-d01-s06.recall.m4a",
    "dur": 8.2,
    "reveal": 5.3
   }
  },
  "w01-d01-s07": {
   "sl": "Ime mi je Marko.",
   "en": "My name is Marko.",
   "hint": null,
   "note": null,
   "intro": {
    "file": "w01-d01-s07.intro.m4a",
    "dur": 16.14
   },
   "recall": {
    "file": "w01-d01-s07.recall.m4a",
    "dur": 7.99,
    "reveal": 4.79
   }
  },
  "w01-d01-s08": {
   "sl": "Me veseli.",
   "en": "Pleased to meet you.",
   "hint": null,
   "note": "Literally 'it gladdens me'.",
   "intro": {
    "file": "w01-d01-s08.intro.m4a",
    "dur": 15.74
   },
   "recall": {
    "file": "w01-d01-s08.recall.m4a",
    "dur": 6.98,
    "reveal": 4.3
   }
  },
  "w01-d01-s09": {
   "sl": "Kje živite?",
   "en": "Where do you live?",
   "hint": "formal",
   "note": null,
   "intro": {
    "file": "w01-d01-s09.intro.m4a",
    "dur": 10.66
   },
   "recall": {
    "file": "w01-d01-s09.recall.m4a",
    "dur": 7.9,
    "reveal": 5.18
   }
  },
  "w01-d01-s10": {
   "sl": "Živim v Ljubljani.",
   "en": "I live in Ljubljana.",
   "hint": null,
   "note": "Locative after v, as in Russian: Ljubljana becomes v Ljubljani.",
   "intro": {
    "file": "w01-d01-s10.intro.m4a",
    "dur": 26.22
   },
   "recall": {
    "file": "w01-d01-s10.recall.m4a",
    "dur": 8.25,
    "reveal": 4.9
   }
  },
  "w01-d02-s01": {
   "sl": "Izvolite?",
   "en": "What can I get you?",
   "hint": null,
   "note": "Izvolite is what staff say to invite your order. It also means 'here you are' when handing something over.",
