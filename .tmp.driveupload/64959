  "week": 3,
  "dialogues": [
    { "id": "w03-d01", "title": "In the classroom", "questions": [
      { "sl": "Ali imaš knjigo?", "en": "Do you have your book?", "answer": "Ne, nimam knjige.", "answer_en": "No, I don't have my book." },
      { "sl": "Ali razumeš nalogo?", "en": "Do you understand the exercise?", "answer": "Ne, ne razumem naloge.", "answer_en": "No, I don't understand the exercise." },
      { "sl": "Kdo ve odgovor?", "en": "Who knows the answer?", "answer": "Jaz vem. Odgovor je pet.", "answer_en": "I know. The answer is five." },
      { "sl": "Ali lahko grem na stranišče?", "en": "Can I go to the toilet?", "answer": "Seveda, pojdi.", "answer_en": "Of course, go." } ] },
    { "id": "w03-d02", "title": "With my classmates", "questions": [
      { "sl": "Kako si?", "en": "How are you?", "answer": "V redu. Pa ti?", "answer_en": "Fine. And you?" },
      { "sl": "Kaj imamo prvo uro?", "en": "What do we have first lesson?", "answer": "Matematiko.", "answer_en": "Maths." },
      { "sl": "Mi lahko posodiš svinčnik?", "en": "Can you lend me a pencil?", "answer": "Seveda. Izvoli.", "answer_en": "Of course. Here you go." },
      { "sl": "Greva po šoli na igrišče?", "en": "Shall we go to the playground after school?", "answer": "Ne morem, imam trening.", "answer_en": "I can't, I have practice." } ] },
    { "id": "w03-d03", "title": "The weather", "questions": [
      { "sl": "Kakšno je vreme danes?", "en": "What's the weather like today?", "answer": "Danes je zelo mrzlo.", "answer_en": "It's very cold today." },
      { "sl": "Kakšno je bilo vreme včeraj?", "en": "What was the weather like yesterday?", "answer": "Včeraj je bilo sončno.", "answer_en": "Yesterday it was sunny." },
      { "sl": "Ali bo jutri snežilo?", "en": "Will it snow tomorrow?", "answer": "Mislim, da ja.", "answer_en": "I think so." },
      { "sl": "Imaš dežnik?", "en": "Do you have an umbrella?", "answer": "Ja, imam ga v torbi.", "answer_en": "Yes, I have it in my bag." } ] },
    { "id": "w03-d04", "title": "Winter sports", "questions": [
      { "sl": "Ali znaš smučati?", "en": "Can you ski?", "answer": "Ja, smučam vsako zimo.", "answer_en": "Yes, I ski every winter." },
      { "sl": "Kam greš smučat?", "en": "Where do you go skiing?", "answer": "Na Krvavec ali v Kranjsko Goro.", "answer_en": "To Krvavec or to Kranjska Gora." },
      { "sl": "Ali je težko?", "en": "Is it hard?", "answer": "Na začetku ja, potem pa je zabavno.", "answer_en": "At the beginning yes, but then it's fun." },
      { "sl": "Greš z nami v soboto?", "en": "Are you coming with us on Saturday?", "answer": "Z veseljem, ampak nimam smuči.", "answer_en": "With pleasure, but I don't have skis." } ] }
  ],
