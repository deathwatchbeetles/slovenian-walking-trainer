{
  "week": 2,
  "dialogues": [
    { "id": "w02-d01", "title": "I'm learning Slovenian", "questions": [
      { "sl": "Ali govorite slovensko?", "en": "Do you speak Slovenian?", "answer": "Samo malo. Učim se.", "answer_en": "Only a little. I'm learning." },
      { "sl": "Katere jezike govorite?", "en": "Which languages do you speak?", "answer": "Govorim angleško in rusko.", "answer_en": "I speak English and Russian." },
      { "sl": "Ali razumete?", "en": "Do you understand?", "answer": "Ne, ne razumem. Ali lahko ponovite?", "answer_en": "No, I don't understand. Can you repeat that?" },
      { "sl": "Govorite rusko?", "en": "Do you speak Russian?", "answer": "Ja, govorim rusko.", "answer_en": "Yes, I speak Russian." } ] },
    { "id": "w02-d02", "title": "At the market", "questions": [
      { "sl": "Želite, prosim?", "en": "What would you like?", "answer": "Kilo jabolk, prosim.", "answer_en": "A kilo of apples, please." },
      { "sl": "Še kaj drugega?", "en": "Anything else?", "answer": "Ja, eno solato in pol kile sira.", "answer_en": "Yes, one lettuce and half a kilo of cheese." },
      { "sl": "Koliko stane solata?", "en": "How much is the lettuce?", "answer": "Solata stane dva evra.", "answer_en": "The lettuce costs two euros." },
      { "sl": "Ali lahko plačam s kartico?", "en": "Can I pay by card?", "answer": "Žal ne, samo gotovina.", "answer_en": "Unfortunately not, cash only." } ] },
    { "id": "w02-d03", "title": "On the bus", "questions": [
      { "sl": "Ali gre ta avtobus v center?", "en": "Does this bus go to the centre?", "answer": "Ne, ta gre na železniško postajo.", "answer_en": "No, this one goes to the railway station." },
      { "sl": "Kje je postaja?", "en": "Where is the stop?", "answer": "Tam, na desni.", "answer_en": "There, on the right." },
      { "sl": "Kdaj pride avtobus?", "en": "When does the bus come?", "answer": "Čez pet minut.", "answer_en": "In five minutes." },
      { "sl": "Kam gre številka šest?", "en": "Where does number six go?", "answer": "Številka šest gre v center.", "answer_en": "Number six goes to the centre." } ] },
    { "id": "w02-d04", "title": "At the restaurant", "questions": [
      { "sl": "Kaj boste pili?", "en": "What will you drink?", "answer": "Kozarec rdečega vina, prosim.", "answer_en": "A glass of red wine, please." },
      { "sl": "Kaj priporočate?", "en": "What do you recommend?", "answer": "Danes imamo dobro juho in ribe.", "answer_en": "Today we have good soup and fish." },
      { "sl": "Kaj boste jedli?", "en": "What will you eat?", "answer": "Jaz bom ribo.", "answer_en": "I'll have the fish." },
      { "sl": "Vam je všeč?", "en": "Do you like it?", "answer": "Ja, zelo je dobro.", "answer_en": "Yes, it's very good." } ] },
    { "id": "w02-d05", "title": "Weather and the weekend", "questions": [
      { "sl": "Kakšno je vreme danes?", "en": "What's the weather like today?", "answer": "Danes je lepo in toplo.", "answer_en": "Today it's nice and warm." },
      { "sl": "Kaj delaš v soboto?", "en": "What are you doing on Saturday?", "answer": "V soboto grem v hribe.", "answer_en": "On Saturday I'm going to the mountains." },
      { "sl": "Sam ali z družino?", "en": "Alone or with the family?", "answer": "Z ženo.", "answer_en": "With my wife." },
      { "sl": "Kje sta otroka?", "en": "Where are the two children?", "answer": "Otroka sta pri babici.", "answer_en": "The children are at grandma's." } ] }
  ],
  "sentences": [
    { "id": "w02-d01-s01", "week": 2, "dialogue": "w02-d01", "sl": "Ali govorite slovensko?", "en": "Do you speak Slovenian?", "hint": "formal", "speaker": "f", "chunks": ["govorite slovensko", "Ali govorite slovensko?"],
      "new_words": [ { "sl": "govoriti", "en": "to speak", "tag": "cognate", "note": null }, { "sl": "slovensko", "en": "(in) Slovenian", "tag": "cognate", "note": null } ],
      "grammar_note": "Languages are adverbs here: {slovensko}, {angleško}, {rusko}." },
    { "id": "w02-d01-s02", "week": 2, "dialogue": "w02-d01", "sl": "Samo malo. Učim se.", "en": "Only a little. I'm learning.", "speaker": "m", "chunks": ["Učim se.", "Samo malo. Učim se."],
      "new_words": [ { "sl": "samo", "en": "only", "tag": "new", "note": null }, { "sl": "malo", "en": "a little", "tag": "cognate", "note": null }, { "sl": "učiti se", "en": "to learn", "tag": "cognate", "note": null } ],
      "grammar_note": "{učim se}: the reflexive {se} is a separate little word, not glued to the verb." },
    { "id": "w02-d01-s03", "week": 2, "dialogue": "w02-d01", "sl": "Zelo dobro govorite!", "en": "You speak very well!", "hint": "formal", "speaker": "f", "chunks": ["dobro govorite", "Zelo dobro govorite!"],
      "new_words": [ { "sl": "zelo", "en": "very", "tag": "new", "note": null } ],
      "grammar_note": "{zelo} means very." },
    { "id": "w02-d01-s04", "week": 2, "dialogue": "w02-d01", "sl": "Hvala. Govorim angleško in rusko.", "en": "Thank you. I speak English and Russian.", "speaker": "m", "chunks": ["angleško in rusko", "Govorim angleško in rusko.", "Hvala. Govorim angleško in rusko."],
      "new_words": [ { "sl": "angleško", "en": "(in) English", "tag": "cognate", "note": null }, { "sl": "rusko", "en": "(in) Russian", "tag": "cognate", "note": null } ],
      "grammar_note": null },
    { "id": "w02-d01-s05", "week": 2, "dialogue": "w02-d01", "sl": "Oprostite, ne razumem.", "en": "Sorry, I don't understand.", "speaker": "m", "chunks": ["ne razumem", "Oprostite, ne razumem."],
      "new_words": [ { "sl": "oprostite", "en": "excuse me, sorry (formal)", "tag": "cognate", "note": null }, { "sl": "razumeti", "en": "to understand", "tag": "cognate", "note": null } ],
      "grammar_note": null },
    { "id": "w02-d01-s06", "week": 2, "dialogue": "w02-d01", "sl": "Ali lahko ponovite?", "en": "Can you repeat that?", "hint": "formal", "speaker": "m", "chunks": ["lahko ponovite", "Ali lahko ponovite?"],
      "new_words": [ { "sl": "lahko", "en": "can, may (literally: easily)", "tag": "cognate", "note": null }, { "sl": "ponoviti", "en": "to repeat", "tag": "cognate", "note": null } ],
      "grammar_note": "'Can' is the word {lahko}, literally 'easily', plus a normal verb: {lahko ponovite}, you can repeat." },
    { "id": "w02-d01-s07", "week": 2, "dialogue": "w02-d01", "sl": "Počasneje, prosim.", "en": "More slowly, please.", "speaker": "m", "chunks": [],
      "new_words": [ { "sl": "počasi", "en": "slowly", "tag": "new", "note": null } ],
      "grammar_note": "{počasi} is slowly. {počasneje} is more slowly." },
    { "id": "w02-d01-s08", "week": 2, "dialogue": "w02-d01", "sl": "Kaj pomeni ta beseda?", "en": "What does this word mean?", "speaker": "m", "chunks": ["ta beseda", "Kaj pomeni ta beseda?"],
      "new_words": [ { "sl": "beseda", "en": "word", "tag": "false_friend", "note": "beseda is a word, not a conversation." }, { "sl": "pomeniti", "en": "to mean", "tag": "new", "note": null } ],
      "grammar_note": "False friend: {beseda} is a word, not a conversation." },
    { "id": "w02-d01-s09", "week": 2, "dialogue": "w02-d01", "sl": "Kako se to reče po slovensko?", "en": "How do you say that in Slovenian?", "speaker": "m", "chunks": ["po slovensko", "to reče po slovensko", "Kako se to reče po slovensko?"],
      "new_words": [ { "sl": "reči", "en": "to say", "tag": "cognate", "note": null } ],
      "grammar_note": null },
    { "id": "w02-d01-s10", "week": 2, "dialogue": "w02-d01", "sl": "Ni problema. Dobro vam gre!", "en": "No problem. You're doing well!", "speaker": "f", "chunks": ["Dobro vam gre!", "Ni problema. Dobro vam gre!"],
      "new_words": [ { "sl": "ni", "en": "is not", "tag": "new", "note": null } ],
      "grammar_note": "{ni} is 'is not', and takes the genitive: {ni problema}. {Dobro vam gre} is literally 'it goes well for you'." },

    { "id": "w02-d02-s01", "week": 2, "dialogue": "w02-d02", "sl": "Želite, prosim?", "en": "What would you like?", "speaker": "f", "chunks": [],
      "new_words": [ { "sl": "želeti", "en": "to wish, want", "tag": "cognate", "note": null } ],
      "grammar_note": null },
    { "id": "w02-d02-s02", "week": 2, "dialogue": "w02-d02", "sl": "Kilo jabolk, prosim.", "en": "A kilo of apples, please.", "speaker": "m", "chunks": ["Kilo jabolk", "Kilo jabolk, prosim."],
      "new_words": [ { "sl": "jabolko", "en": "apple", "tag": "cognate", "note": null } ],
      "grammar_note": "After a quantity, genitive, as in Russian: {kilo jabolk}." },
    { "id": "w02-d02-s03", "week": 2, "dialogue": "w02-d02", "sl": "Še kaj drugega?", "en": "Anything else?", "speaker": "f", "chunks": [],
      "new_words": [ { "sl": "drug", "en": "other", "tag": "cognate", "note": null } ],
      "grammar_note": null },
    { "id": "w02-d02-s04", "week": 2, "dialogue": "w02-d02", "sl": "Koliko stane solata?", "en": "How much is the lettuce?", "speaker": "m", "chunks": ["stane solata", "Koliko stane solata?"],
      "new_words": [ { "sl": "stati", "en": "to cost", "tag": "cognate", "note": null }, { "sl": "solata", "en": "lettuce, salad", "tag": "cognate", "note": null } ],
      "grammar_note": "{stane} is 'costs'. {solata} is lettuce as well as salad." },
    { "id": "w02-d02-s05", "week": 2, "dialogue": "w02-d02", "sl": "Dva evra.", "en": "Two euros.", "speaker": "f", "chunks": [],
      "new_words": [],
      "grammar_note": "Dual: {dva evra}. Five was {pet evrov}." },
    { "id": "w02-d02-s06", "week": 2, "dialogue": "w02-d02", "sl": "Dobro, eno solato in pol kile sira.", "en": "Good, one lettuce and half a kilo of cheese.", "speaker": "m", "chunks": ["pol kile sira", "in pol kile sira", "eno solato in pol kile sira", "Dobro, eno solato in pol kile sira."],
      "new_words": [ { "sl": "pol", "en": "half", "tag": "cognate", "note": null }, { "sl": "sir", "en": "cheese", "tag": "cognate", "note": null } ],
      "grammar_note": null },
    { "id": "w02-d02-s07", "week": 2, "dialogue": "w02-d02", "sl": "Ali je sir domač?", "en": "Is the cheese local?", "speaker": "m", "chunks": ["je sir domač", "Ali je sir domač?"],
      "new_words": [ { "sl": "domač", "en": "homemade, local", "tag": "cognate", "note": null } ],
      "grammar_note": "{domač} is homemade or local." },
    { "id": "w02-d02-s08", "week": 2, "dialogue": "w02-d02", "sl": "Ja, vse je domače.", "en": "Yes, everything is home-grown.", "speaker": "f", "chunks": ["vse je domače", "Ja, vse je domače."],
      "new_words": [], "grammar_note": null },
    { "id": "w02-d02-s09", "week": 2, "dialogue": "w02-d02", "sl": "Ali lahko plačam s kartico?", "en": "Can I pay by card?", "speaker": "m", "chunks": ["s kartico", "plačam s kartico", "Ali lahko plačam s kartico?"],
      "new_words": [ { "sl": "plačati", "en": "to pay", "tag": "cognate", "note": null }, { "sl": "kartica", "en": "card", "tag": "cognate", "note": null } ],
      "grammar_note": "Instrumental again: {s kartico}. The word {z} becomes {s} before sounds like k, p and t." },
    { "id": "w02-d02-s10", "week": 2, "dialogue": "w02-d02", "sl": "Žal ne, samo gotovina.", "en": "Unfortunately not, cash only.", "speaker": "f", "chunks": ["samo gotovina", "Žal ne, samo gotovina."],
      "new_words": [ { "sl": "žal", "en": "unfortunately", "tag": "cognate", "note": null }, { "sl": "gotovina", "en": "cash", "tag": "new", "note": null } ],
      "grammar_note": "{gotovina} is cash." },

    { "id": "w02-d03-s01", "week": 2, "dialogue": "w02-d03", "sl": "Oprostite, ali gre ta avtobus v center?", "en": "Excuse me, does this bus go to the centre?", "speaker": "m", "chunks": ["v center", "gre ta avtobus v center", "Oprostite, ali gre ta avtobus v center?"],
      "new_words": [ { "sl": "avtobus", "en": "bus", "tag": "cognate", "note": null }, { "sl": "gre", "en": "goes", "tag": "new", "note": null } ],
      "grammar_note": "Direction takes the accusative: {v center}. Location takes the locative: {v centru}. The same split as in Russian." },
    { "id": "w02-d03-s02", "week": 2, "dialogue": "w02-d03", "sl": "Ne, ta gre na železniško postajo.", "en": "No, this one goes to the railway station.", "speaker": "f", "chunks": ["na železniško postajo", "ta gre na železniško postajo", "Ne, ta gre na železniško postajo."],
      "new_words": [ { "sl": "postaja", "en": "station, stop", "tag": "new", "note": null } ],
      "grammar_note": "{železniška postaja} is the railway station. A bus stop is just {postaja}." },
    { "id": "w02-d03-s03", "week": 2, "dialogue": "w02-d03", "sl": "V center gre številka šest.", "en": "Number six goes to the centre.", "speaker": "f", "chunks": ["številka šest", "gre številka šest", "V center gre številka šest."],
      "new_words": [ { "sl": "številka", "en": "number", "tag": "new", "note": null }, { "sl": "šest", "en": "six", "tag": "cognate", "note": null } ],
      "grammar_note": "{številka} is number." },
    { "id": "w02-d03-s04", "week": 2, "dialogue": "w02-d03", "sl": "Kje je postaja?", "en": "Where is the stop?", "speaker": "m", "chunks": [],
      "new_words": [], "grammar_note": null },
    { "id": "w02-d03-s05", "week": 2, "dialogue": "w02-d03", "sl": "Tam, na desni.", "en": "There, on the right.", "speaker": "f", "chunks": [],
      "new_words": [ { "sl": "tam", "en": "there", "tag": "cognate", "note": null }, { "sl": "desno", "en": "right", "tag": "new", "note": null } ],
      "grammar_note": "{na desni} is on the right. On the left is {na levi}." },
    { "id": "w02-d03-s06", "week": 2, "dialogue": "w02-d03", "sl": "Kdaj pride avtobus?", "en": "When does the bus come?", "speaker": "m", "chunks": ["pride avtobus", "Kdaj pride avtobus?"],
      "new_words": [ { "sl": "kdaj", "en": "when", "tag": "new", "note": null }, { "sl": "priti", "en": "to come, arrive", "tag": "cognate", "note": null } ],
      "grammar_note": "{kdaj} is when." },
    { "id": "w02-d03-s07", "week": 2, "dialogue": "w02-d03", "sl": "Čez pet minut.", "en": "In five minutes.", "speaker": "f", "chunks": [],
      "new_words": [ { "sl": "čez", "en": "in (after a time), across", "tag": "cognate", "note": null } ],
      "grammar_note": "{čez} with a time means 'in', as in Russian." },
    { "id": "w02-d03-s08", "week": 2, "dialogue": "w02-d03", "sl": "Koliko stane vozovnica?", "en": "How much is a ticket?", "speaker": "m", "chunks": ["stane vozovnica", "Koliko stane vozovnica?"],
      "new_words": [ { "sl": "vozovnica", "en": "ticket (transport)", "tag": "new", "note": null } ],
      "grammar_note": "{vozovnica} is a ticket for transport." },
    { "id": "w02-d03-s09", "week": 2, "dialogue": "w02-d03", "sl": "Lahko plačate s kartico.", "en": "You can pay by card.", "hint": "formal", "speaker": "f", "chunks": ["s kartico", "Lahko plačate s kartico."],
      "new_words": [], "grammar_note": null },
    { "id": "w02-d03-s10", "week": 2, "dialogue": "w02-d03", "sl": "Hvala za pomoč!", "en": "Thanks for the help!", "speaker": "m", "chunks": ["za pomoč", "Hvala za pomoč!"],
      "new_words": [ { "sl": "pomoč", "en": "help", "tag": "cognate", "note": null } ],
      "grammar_note": null },

    { "id": "w02-d04-s01", "week": 2, "dialogue": "w02-d04", "sl": "Mizo za dva, prosim.", "en": "A table for two, please.", "speaker": "m", "chunks": ["za dva", "Mizo za dva, prosim."],
      "new_words": [ { "sl": "miza", "en": "table", "tag": "new", "note": "Table is miza. stol is a chair." } ],
      "grammar_note": "False friend nearby: a table is {miza}. The word {stol} means a chair." },
    { "id": "w02-d04-s02", "week": 2, "dialogue": "w02-d04", "sl": "Izvolite. Tukaj je jedilni list.", "en": "Here you are. Here is the menu.", "speaker": "f", "chunks": ["jedilni list", "Tukaj je jedilni list.", "Izvolite. Tukaj je jedilni list."],
      "new_words": [ { "sl": "tukaj", "en": "here", "tag": "new", "note": null }, { "sl": "jedilni list", "en": "menu", "tag": "new", "note": null } ],
      "grammar_note": "{jedilni list} is the menu, literally 'eating sheet'." },
    { "id": "w02-d04-s03", "week": 2, "dialogue": "w02-d04", "sl": "Kaj boste pili?", "en": "What will you drink?", "hint": "formal", "speaker": "f", "chunks": ["boste pili", "Kaj boste pili?"],
      "new_words": [ { "sl": "piti", "en": "to drink", "tag": "cognate", "note": null } ],
      "grammar_note": "The future, as a fixed phrase for now: {boste} plus the L form of the verb, the same form Russian uses for the past. {Boste pili}, you will drink." },
    { "id": "w02-d04-s04", "week": 2, "dialogue": "w02-d04", "sl": "Kozarec rdečega vina, prosim.", "en": "A glass of red wine, please.", "speaker": "m", "chunks": ["rdečega vina", "Kozarec rdečega vina", "Kozarec rdečega vina, prosim."],
      "new_words": [ { "sl": "kozarec", "en": "glass", "tag": "new", "note": null }, { "sl": "rdeč", "en": "red", "tag": "new", "note": null }, { "sl": "vino", "en": "wine", "tag": "cognate", "note": null } ],
      "grammar_note": "{kozarec} is a glass, and {rdeč} is red. Genitive after a container: {rdečega vina}." },
    { "id": "w02-d04-s05", "week": 2, "dialogue": "w02-d04", "sl": "Kaj priporočate?", "en": "What do you recommend?", "hint": "formal", "speaker": "m", "chunks": [],
      "new_words": [ { "sl": "priporočati", "en": "to recommend", "tag": "new", "note": null } ],
      "grammar_note": null },
    { "id": "w02-d04-s06", "week": 2, "dialogue": "w02-d04", "sl": "Danes imamo dobro juho in ribe.", "en": "Today we have good soup and fish.", "speaker": "f", "chunks": ["juho in ribe", "dobro juho in ribe", "imamo dobro juho in ribe", "Danes imamo dobro juho in ribe."],
      "new_words": [ { "sl": "juha", "en": "soup", "tag": "cognate", "note": null }, { "sl": "riba", "en": "fish", "tag": "cognate", "note": null } ],
      "grammar_note": null },
    { "id": "w02-d04-s07", "week": 2, "dialogue": "w02-d04", "sl": "Jaz bom ribo.", "en": "I'll have the fish.", "speaker": "m", "chunks": [],
      "new_words": [ { "sl": "bom", "en": "I will (be)", "tag": "cognate", "note": null } ],
      "grammar_note": "When ordering, {bom} on its own means 'I'll have'." },
    { "id": "w02-d04-s08", "week": 2, "dialogue": "w02-d04", "sl": "Vam je všeč?", "en": "Do you like it?", "hint": "formal", "speaker": "f", "chunks": [],
      "new_words": [ { "sl": "všeč", "en": "pleasing", "tag": "new", "note": null } ],
      "grammar_note": "Liking works as in Russian: the person is in the dative. {Vam je všeč}: is it pleasing to you?" },
    { "id": "w02-d04-s09", "week": 2, "dialogue": "w02-d04", "sl": "Ja, zelo je dobro.", "en": "Yes, it's very good.", "speaker": "m", "chunks": ["zelo je dobro", "Ja, zelo je dobro."],
      "new_words": [],
      "grammar_note": "Second position again: {je} comes straight after {zelo}." },
    { "id": "w02-d04-s10", "week": 2, "dialogue": "w02-d04", "sl": "Račun, prosim.", "en": "The bill, please.", "speaker": "m", "chunks": [],
      "new_words": [ { "sl": "račun", "en": "bill", "tag": "new", "note": null } ],
      "grammar_note": null },

    { "id": "w02-d05-s01", "week": 2, "dialogue": "w02-d05", "sl": "Kakšno je vreme danes?", "en": "What's the weather like today?", "speaker": "f", "chunks": ["je vreme danes", "Kakšno je vreme danes?"],
      "new_words": [ { "sl": "vreme", "en": "weather", "tag": "false_friend", "note": "vreme is weather. Time is čas." }, { "sl": "kakšen", "en": "what kind of", "tag": "cognate", "note": null } ],
      "grammar_note": "False friend: {vreme} is weather. Time is {čas}." },
    { "id": "w02-d05-s02", "week": 2, "dialogue": "w02-d05", "sl": "Danes je lepo in toplo.", "en": "Today it's nice and warm.", "speaker": "m", "chunks": ["lepo in toplo", "Danes je lepo in toplo."],
      "new_words": [ { "sl": "toplo", "en": "warm", "tag": "cognate", "note": null } ],
      "grammar_note": null },
    { "id": "w02-d05-s03", "week": 2, "dialogue": "w02-d05", "sl": "Jutri bo dež.", "en": "Tomorrow there will be rain.", "speaker": "f", "chunks": [],
      "new_words": [ { "sl": "dež", "en": "rain", "tag": "cognate", "note": null }, { "sl": "bo", "en": "will be", "tag": "cognate", "note": null } ],
      "grammar_note": "{bo} is 'will be'." },
    { "id": "w02-d05-s04", "week": 2, "dialogue": "w02-d05", "sl": "Škoda! Ne maram dežja.", "en": "What a pity! I don't like rain.", "speaker": "m", "chunks": ["Ne maram dežja.", "Škoda! Ne maram dežja."],
      "new_words": [ { "sl": "škoda", "en": "pity", "tag": "german_loan", "note": null }, { "sl": "marati", "en": "to like, care for", "tag": "new", "note": null } ],
      "grammar_note": "{škoda} is 'what a pity', like German. And genitive after a negated verb: {dež} becomes {dežja}." },
    { "id": "w02-d05-s05", "week": 2, "dialogue": "w02-d05", "sl": "Kaj delaš v soboto?", "en": "What are you doing on Saturday?", "hint": "informal", "speaker": "f", "chunks": ["v soboto", "Kaj delaš v soboto?"],
      "new_words": [ { "sl": "sobota", "en": "Saturday", "tag": "cognate", "note": null } ],
      "grammar_note": "Days take {v} plus accusative, as in Russian: {v soboto}." },
    { "id": "w02-d05-s06", "week": 2, "dialogue": "w02-d05", "sl": "V soboto grem v hribe.", "en": "On Saturday I'm going to the mountains.", "speaker": "m", "chunks": ["v hribe", "grem v hribe", "V soboto grem v hribe."],
      "new_words": [ { "sl": "grem", "en": "I go", "tag": "new", "note": null }, { "sl": "hrib", "en": "hill, mountain", "tag": "new", "note": null } ],
      "grammar_note": "{grem} is 'I go'. {hribi} are the hills or mountains." },
    { "id": "w02-d05-s07", "week": 2, "dialogue": "w02-d05", "sl": "Sam ali z družino?", "en": "Alone or with the family?", "speaker": "f", "chunks": ["z družino", "Sam ali z družino?"],
      "new_words": [ { "sl": "sam", "en": "alone", "tag": "cognate", "note": null } ],
      "grammar_note": null },
    { "id": "w02-d05-s08", "week": 2, "dialogue": "w02-d05", "sl": "Z ženo. Otroka sta pri babici.", "en": "With my wife. The children are at grandma's.", "speaker": "m", "chunks": ["pri babici", "Otroka sta pri babici.", "Z ženo. Otroka sta pri babici."],
      "new_words": [ { "sl": "žena", "en": "wife", "tag": "cognate", "note": null }, { "sl": "babica", "en": "grandmother", "tag": "cognate", "note": null } ],
      "grammar_note": "Dual: {otroka sta}, the two children are." },
    { "id": "w02-d05-s09", "week": 2, "dialogue": "w02-d05", "sl": "Lepo! Jaz bom doma.", "en": "Nice! I'll be at home.", "speaker": "f", "chunks": ["Jaz bom doma.", "Lepo! Jaz bom doma."],
      "new_words": [], "grammar_note": null },
    { "id": "w02-d05-s10", "week": 2, "dialogue": "w02-d05", "sl": "Lep vikend ti želim!", "en": "I wish you a nice weekend!", "hint": "informal", "speaker": "m", "chunks": ["ti želim", "Lep vikend ti želim!"],
      "new_words": [ { "sl": "vikend", "en": "weekend", "tag": "new", "note": null } ],
      "grammar_note": "{ti} is 'to you', informal. The usual reply is {hvala, enako}: thanks, same to you." }
  ]
