{
  "week": 1,
  "dialogues": [
    { "id": "w01-d01", "title": "Meeting a neighbour", "questions": [
      { "sl": "Kako ste?", "en": "How are you?", "answer": "Dobro, hvala. Pa vi?", "answer_en": "Fine, thank you. And you?" },
      { "sl": "Kako vam je ime?", "en": "What is your name?", "answer": "Ime mi je Marko.", "answer_en": "My name is Marko." },
      { "sl": "Kje živite?", "en": "Where do you live?", "answer": "Živim v Ljubljani.", "answer_en": "I live in Ljubljana." },
      { "sl": "Kje živi Ana?", "en": "Where does Ana live?", "answer": "Ana živi v Ljubljani.", "answer_en": "Ana lives in Ljubljana." } ] },
    { "id": "w01-d02", "title": "At the café", "questions": [
      { "sl": "Izvolite?", "en": "What can I get you?", "answer": "Eno kavo, prosim.", "answer_en": "One coffee, please." },
      { "sl": "Z mlekom ali brez?", "en": "With milk or without?", "answer": "Z mlekom, prosim.", "answer_en": "With milk, please." },
      { "sl": "Še kaj?", "en": "Anything else?", "answer": "Ja, en čaj in eno vodo.", "answer_en": "Yes, one tea and one water." },
      { "sl": "Koliko je to?", "en": "How much is that?", "answer": "Pet evrov, prosim.", "answer_en": "Five euros, please." } ] },
    { "id": "w01-d03", "title": "At the bakery", "questions": [
      { "sl": "Ali imate kruh?", "en": "Do you have bread?", "answer": "Ja, imamo bel in črn kruh.", "answer_en": "Yes, we have white and dark bread." },
      { "sl": "Imate tudi rogljičke?", "en": "Do you also have croissants?", "answer": "Ne, danes nimamo rogljičkov.", "answer_en": "No, today we don't have any croissants." },
      { "sl": "Kaj imate danes?", "en": "What do you have today?", "answer": "Imamo kruh in burek.", "answer_en": "We have bread and burek." },
      { "sl": "Bo to vse?", "en": "Will that be everything?", "answer": "Ja, to je vse, hvala.", "answer_en": "Yes, that's everything, thank you." } ] },
    { "id": "w01-d04", "title": "Family small talk", "questions": [
      { "sl": "Ali imate otroke?", "en": "Do you have children?", "answer": "Ja, imam sina in hčerko.", "answer_en": "Yes, I have a son and a daughter." },
      { "sl": "Koliko je star sin?", "en": "How old is the son?", "answer": "Sin je star pet let.", "answer_en": "The son is five years old." },
      { "sl": "Imate psa?", "en": "Do you have a dog?", "answer": "Ne, nimam psa. Imam mačko.", "answer_en": "No, I don't have a dog. I have a cat." },
      { "sl": "Kje delate?", "en": "Where do you work?", "answer": "Delam doma.", "answer_en": "I work at home." } ] },
    { "id": "w01-d05", "title": "Making a plan", "questions": [
      { "sl": "Koliko je ura?", "en": "What time is it?", "answer": "Ura je tri.", "answer_en": "It's three o'clock." },
      { "sl": "Imaš danes čas?", "en": "Do you have time today?", "answer": "Danes nimam časa.", "answer_en": "Today I don't have time." },
      { "sl": "Kaj pa jutri?", "en": "And what about tomorrow?", "answer": "Jutri imam čas.", "answer_en": "Tomorrow I have time." },
      { "sl": "Greva na kavo?", "en": "Shall we go for a coffee?", "answer": "Ja, z veseljem.", "answer_en": "Yes, with pleasure." } ] }
  ],
  "sentences": [
    { "id": "w01-d01-s01", "week": 1, "dialogue": "w01-d01", "sl": "Dober dan!", "en": "Hello, good day.", "speaker": "f", "chunks": [],
      "new_words": [ { "sl": "dober", "en": "good", "tag": "cognate", "note": null }, { "sl": "dan", "en": "day", "tag": "cognate", "note": null } ],
      "grammar_note": null },
    { "id": "w01-d01-s02", "week": 1, "dialogue": "w01-d01", "sl": "Kako ste?", "en": "How are you?", "hint": "formal", "speaker": "m", "chunks": [],
      "new_words": [ { "sl": "kako", "en": "how", "tag": "cognate", "note": null }, { "sl": "ste", "en": "you are (formal/plural)", "tag": "new", "note": null } ],
      "grammar_note": "{ste} is 'you are', formal or plural. Unlike Russian, the verb 'to be' is always said in the present." },
    { "id": "w01-d01-s03", "week": 1, "dialogue": "w01-d01", "sl": "Dobro, hvala. Pa vi?", "en": "Fine, thank you. And you?", "speaker": "f", "chunks": ["Pa vi?", "Dobro, hvala. Pa vi?"],
      "new_words": [ { "sl": "hvala", "en": "thank you", "tag": "cognate", "note": null }, { "sl": "pa", "en": "and (in return), but", "tag": "new", "note": null }, { "sl": "in", "en": "and", "tag": "new", "note": null }, { "sl": "vi", "en": "you (formal/plural)", "tag": "cognate", "note": null } ],
      "grammar_note": "'And you?' is {pa vi}. Plain 'and' is {in}." },
    { "id": "w01-d01-s04", "week": 1, "dialogue": "w01-d01", "sl": "Tudi dobro, hvala.", "en": "Also fine, thank you.", "speaker": "m", "chunks": [],
      "new_words": [ { "sl": "tudi", "en": "also", "tag": "new", "note": null } ],
      "grammar_note": null },
    { "id": "w01-d01-s05", "week": 1, "dialogue": "w01-d01", "sl": "Jaz sem Ana.", "en": "I am Ana.", "speaker": "f", "chunks": [],
      "new_words": [ { "sl": "jaz", "en": "I", "tag": "cognate", "note": null }, { "sl": "sem", "en": "am", "tag": "new", "note": null } ],
      "grammar_note": "Slovenian needs the verb: {jaz sem}, I am. You can drop {jaz}, but never {sem}." },
    { "id": "w01-d01-s06", "week": 1, "dialogue": "w01-d01", "sl": "Kako vam je ime?", "en": "What is your name?", "hint": "formal", "speaker": "f", "chunks": ["je ime", "vam je ime", "Kako vam je ime?"],
      "new_words": [ { "sl": "ime", "en": "name", "tag": "cognate", "note": null }, { "sl": "vam", "en": "to you", "tag": "cognate", "note": null } ],
      "grammar_note": "Literally 'how to you is name'. The little words {vam} and {je} normally sit in second position." },
    { "id": "w01-d01-s07", "week": 1, "dialogue": "w01-d01", "sl": "Ime mi je Marko.", "en": "My name is Marko.", "speaker": "m", "chunks": ["mi je Marko", "Ime mi je Marko."],
      "new_words": [ { "sl": "mi", "en": "to me", "tag": "cognate", "note": null } ],
      "grammar_note": null },
    { "id": "w01-d01-s08", "week": 1, "dialogue": "w01-d01", "sl": "Me veseli.", "en": "Pleased to meet you.", "speaker": "f", "chunks": [],
      "new_words": [ { "sl": "veseliti", "en": "to gladden", "tag": "cognate", "note": null } ],
      "grammar_note": "Literally 'it gladdens me'." },
    { "id": "w01-d01-s09", "week": 1, "dialogue": "w01-d01", "sl": "Kje živite?", "en": "Where do you live?", "hint": "formal", "speaker": "m", "chunks": [],
      "new_words": [ { "sl": "kje", "en": "where", "tag": "new", "note": null }, { "sl": "živeti", "en": "to live", "tag": "cognate", "note": null } ],
      "grammar_note": null },
    { "id": "w01-d01-s10", "week": 1, "dialogue": "w01-d01", "sl": "Živim v Ljubljani.", "en": "I live in Ljubljana.", "speaker": "f", "chunks": ["v Ljubljani", "Živim v Ljubljani."],
      "new_words": [ { "sl": "v", "en": "in", "tag": "cognate", "note": null } ],
      "grammar_note": "Locative after {v}, as in Russian: {Ljubljana} becomes {v Ljubljani}." },

    { "id": "w01-d02-s01", "week": 1, "dialogue": "w01-d02", "sl": "Izvolite?", "en": "What can I get you?", "speaker": "f", "chunks": [],
      "new_words": [ { "sl": "izvolite", "en": "please / here you are", "tag": "cognate", "note": null } ],
      "grammar_note": "{Izvolite} is what staff say to invite your order. It also means 'here you are' when handing something over." },
    { "id": "w01-d02-s02", "week": 1, "dialogue": "w01-d02", "sl": "Eno kavo, prosim.", "en": "One coffee, please.", "speaker": "m", "chunks": [],
      "new_words": [ { "sl": "kava", "en": "coffee", "tag": "cognate", "note": null }, { "sl": "prosim", "en": "please", "tag": "cognate", "note": null }, { "sl": "ena", "en": "one (f)", "tag": "new", "note": null } ],
      "grammar_note": "Accusative: {ena kava} becomes {eno kavo}." },
    { "id": "w01-d02-s03", "week": 1, "dialogue": "w01-d02", "sl": "Z mlekom ali brez?", "en": "With milk or without?", "speaker": "f", "chunks": ["ali brez", "Z mlekom ali brez?"],
      "new_words": [ { "sl": "mleko", "en": "milk", "tag": "cognate", "note": null }, { "sl": "ali", "en": "or", "tag": "new", "note": null }, { "sl": "brez", "en": "without", "tag": "cognate", "note": null } ],
      "grammar_note": "Instrumental after {z}, as in Russian: {z mlekom}. And {ali} means 'or'." },
    { "id": "w01-d02-s04", "week": 1, "dialogue": "w01-d02", "sl": "Z mlekom, prosim.", "en": "With milk, please.", "speaker": "m", "chunks": [],
      "new_words": [], "grammar_note": null },
    { "id": "w01-d02-s05", "week": 1, "dialogue": "w01-d02", "sl": "Še kaj?", "en": "Anything else?", "speaker": "f", "chunks": [],
      "new_words": [ { "sl": "še", "en": "more, still", "tag": "cognate", "note": null }, { "sl": "kaj", "en": "what, something", "tag": "new", "note": null } ],
      "grammar_note": "{še} is 'more' or 'still'. {kaj} is 'what', and also 'something'." },
    { "id": "w01-d02-s06", "week": 1, "dialogue": "w01-d02", "sl": "Ja, en čaj in eno vodo.", "en": "Yes, one tea and one water.", "speaker": "m", "chunks": ["eno vodo", "in eno vodo", "en čaj in eno vodo", "Ja, en čaj in eno vodo."],
      "new_words": [ { "sl": "čaj", "en": "tea", "tag": "cognate", "note": null }, { "sl": "voda", "en": "water", "tag": "cognate", "note": null } ],
      "grammar_note": null },
    { "id": "w01-d02-s07", "week": 1, "dialogue": "w01-d02", "sl": "Koliko je to?", "en": "How much is that?", "speaker": "m", "chunks": [],
      "new_words": [ { "sl": "koliko", "en": "how much", "tag": "cognate", "note": null } ],
      "grammar_note": null },
    { "id": "w01-d02-s08", "week": 1, "dialogue": "w01-d02", "sl": "Pet evrov, prosim.", "en": "Five euros, please.", "speaker": "f", "chunks": [],
      "new_words": [ { "sl": "pet", "en": "five", "tag": "cognate", "note": null }, { "sl": "evro", "en": "euro", "tag": "cognate", "note": null } ],
      "grammar_note": "From five up, genitive plural, as in Russian: {pet evrov}." },
    { "id": "w01-d02-s09", "week": 1, "dialogue": "w01-d02", "sl": "Izvolite.", "en": "Here you are.", "speaker": "m", "chunks": [],
      "new_words": [], "grammar_note": null },
    { "id": "w01-d02-s10", "week": 1, "dialogue": "w01-d02", "sl": "Hvala lepa. Na svidenje!", "en": "Thank you very much. Goodbye!", "speaker": "f", "chunks": ["Na svidenje!", "Hvala lepa. Na svidenje!"],
      "new_words": [ { "sl": "na svidenje", "en": "goodbye", "tag": "cognate", "note": null }, { "sl": "lep", "en": "beautiful, nice", "tag": "new", "note": null } ],
      "grammar_note": "{Na svidenje} uses the same word as the Russian goodbye. {Hvala lepa} is literally 'beautiful thanks'." },

    { "id": "w01-d03-s01", "week": 1, "dialogue": "w01-d03", "sl": "Dobro jutro!", "en": "Good morning!", "speaker": "f", "chunks": [],
      "new_words": [ { "sl": "jutro", "en": "morning", "tag": "cognate", "note": "Careful: jutri means tomorrow." } ],
      "grammar_note": "{jutro} is morning. Careful: {jutri} means tomorrow." },
    { "id": "w01-d03-s02", "week": 1, "dialogue": "w01-d03", "sl": "Ali imate kruh?", "en": "Do you have bread?", "speaker": "m", "chunks": ["imate kruh", "Ali imate kruh?"],
      "new_words": [ { "sl": "imeti", "en": "to have", "tag": "cognate", "note": null }, { "sl": "kruh", "en": "bread", "tag": "new", "note": null } ],
      "grammar_note": "Here {ali} opens a yes or no question. And Slovenian uses a normal verb for 'to have': {imam}, {imate}." },
    { "id": "w01-d03-s03", "week": 1, "dialogue": "w01-d03", "sl": "Ja, imamo bel in črn kruh.", "en": "Yes, we have white and dark bread.", "speaker": "f", "chunks": ["črn kruh", "bel in črn kruh", "imamo bel in črn kruh", "Ja, imamo bel in črn kruh."],
      "new_words": [ { "sl": "bel", "en": "white", "tag": "cognate", "note": null }, { "sl": "črn", "en": "black, dark", "tag": "cognate", "note": null } ],
      "grammar_note": null },
    { "id": "w01-d03-s04", "week": 1, "dialogue": "w01-d03", "sl": "En bel kruh, prosim.", "en": "One white bread, please.", "speaker": "m", "chunks": ["bel kruh", "En bel kruh, prosim."],
      "new_words": [ { "sl": "en", "en": "one (m)", "tag": "new", "note": null } ],
      "grammar_note": null },
    { "id": "w01-d03-s05", "week": 1, "dialogue": "w01-d03", "sl": "Imate tudi rogljičke?", "en": "Do you also have croissants?", "speaker": "m", "chunks": ["tudi rogljičke", "Imate tudi rogljičke?"],
      "new_words": [ { "sl": "rogljiček", "en": "croissant", "tag": "new", "note": null } ],
      "grammar_note": "{rogljiček} is a little horn, a croissant." },
    { "id": "w01-d03-s06", "week": 1, "dialogue": "w01-d03", "sl": "Ne, danes nimamo rogljičkov.", "en": "No, today we don't have any croissants.", "speaker": "f", "chunks": ["nimamo rogljičkov", "danes nimamo rogljičkov", "Ne, danes nimamo rogljičkov."],
      "new_words": [ { "sl": "danes", "en": "today", "tag": "new", "note": null }, { "sl": "nimamo", "en": "we don't have", "tag": "new", "note": null } ],
      "grammar_note": "{nimamo} is 'we don't have', and it takes the genitive, like the Russian 'there is no': {nimamo rogljičkov}." },
    { "id": "w01-d03-s07", "week": 1, "dialogue": "w01-d03", "sl": "Potem pa dva bureka.", "en": "Then two bureks.", "speaker": "m", "chunks": ["dva bureka", "Potem pa dva bureka."],
      "new_words": [ { "sl": "potem", "en": "then", "tag": "cognate", "note": null }, { "sl": "dva", "en": "two", "tag": "cognate", "note": null } ],
      "grammar_note": "This is the dual. Two of anything has its own ending: {dva bureka}." },
    { "id": "w01-d03-s08", "week": 1, "dialogue": "w01-d03", "sl": "Bo to vse?", "en": "Will that be everything?", "speaker": "f", "chunks": [],
      "new_words": [ { "sl": "vse", "en": "everything", "tag": "cognate", "note": null }, { "sl": "bo", "en": "will be", "tag": "cognate", "note": null } ],
      "grammar_note": "{bo} is 'will be'. Shop staff ask {Bo to vse}: will that be all?" },
    { "id": "w01-d03-s09", "week": 1, "dialogue": "w01-d03", "sl": "Ja, to je vse, hvala.", "en": "Yes, that's everything, thank you.", "speaker": "m", "chunks": ["to je vse", "Ja, to je vse, hvala."],
      "new_words": [], "grammar_note": null },
    { "id": "w01-d03-s10", "week": 1, "dialogue": "w01-d03", "sl": "Hvala in lep dan!", "en": "Thank you, and have a nice day!", "speaker": "f", "chunks": ["lep dan", "Hvala in lep dan!"],
      "new_words": [], "grammar_note": null },

    { "id": "w01-d04-s01", "week": 1, "dialogue": "w01-d04", "sl": "Ali imate otroke?", "en": "Do you have children?", "hint": "formal", "speaker": "f", "chunks": ["imate otroke", "Ali imate otroke?"],
      "new_words": [ { "sl": "otrok", "en": "child", "tag": "cognate", "note": null } ],
      "grammar_note": null },
    { "id": "w01-d04-s02", "week": 1, "dialogue": "w01-d04", "sl": "Ja, imam sina in hčerko.", "en": "Yes, I have a son and a daughter.", "speaker": "m", "chunks": ["in hčerko", "sina in hčerko", "imam sina in hčerko", "Ja, imam sina in hčerko."],
      "new_words": [ { "sl": "sin", "en": "son", "tag": "cognate", "note": null }, { "sl": "hčerka", "en": "daughter", "tag": "cognate", "note": null } ],
      "grammar_note": null },
    { "id": "w01-d04-s03", "week": 1, "dialogue": "w01-d04", "sl": "Koliko sta stara?", "en": "How old are they?", "hint": "the two of them", "speaker": "f", "chunks": ["sta stara", "Koliko sta stara?"],
      "new_words": [ { "sl": "star", "en": "old", "tag": "cognate", "note": null }, { "sl": "sta", "en": "they two are", "tag": "new", "note": null } ],
      "grammar_note": "Dual again: {sta} is 'the two of them are', and {stara} has the dual ending. For three or more it would be {so stari}." },
    { "id": "w01-d04-s04", "week": 1, "dialogue": "w01-d04", "sl": "Sin je star pet let.", "en": "My son is five years old.", "speaker": "m", "chunks": ["pet let", "star pet let", "Sin je star pet let."],
      "new_words": [ { "sl": "leto", "en": "year", "tag": "false_friend", "note": "leto is a year, not summer. Summer is poletje." } ],
      "grammar_note": "{pet let} works exactly as in Russian. But the singular {leto} means a year, not summer. Summer is {poletje}." },
    { "id": "w01-d04-s05", "week": 1, "dialogue": "w01-d04", "sl": "Hčerka pa tri leta.", "en": "And my daughter is three.", "speaker": "m", "chunks": ["tri leta", "Hčerka pa tri leta."],
      "new_words": [ { "sl": "tri", "en": "three", "tag": "cognate", "note": null } ],
      "grammar_note": "Here {pa} marks a contrast, like 'and as for'. Three and four take {leta}; five and up take {let}." },
    { "id": "w01-d04-s06", "week": 1, "dialogue": "w01-d04", "sl": "Imate tudi psa?", "en": "Do you also have a dog?", "hint": "formal", "speaker": "f", "chunks": ["tudi psa", "Imate tudi psa?"],
      "new_words": [ { "sl": "pes", "en": "dog", "tag": "cognate", "note": null } ],
      "grammar_note": null },
    { "id": "w01-d04-s07", "week": 1, "dialogue": "w01-d04", "sl": "Ne, nimam psa. Imam mačko.", "en": "No, I don't have a dog. I have a cat.", "speaker": "m", "chunks": ["Imam mačko.", "nimam psa", "Ne, nimam psa. Imam mačko."],
      "new_words": [ { "sl": "mačka", "en": "cat", "tag": "new", "note": null } ],
      "grammar_note": null },
    { "id": "w01-d04-s08", "week": 1, "dialogue": "w01-d04", "sl": "Kje delate?", "en": "Where do you work?", "hint": "formal", "speaker": "f", "chunks": [],
      "new_words": [ { "sl": "delati", "en": "to work", "tag": "cognate", "note": null } ],
      "grammar_note": "{delati} means to work, not just to do." },
    { "id": "w01-d04-s09", "week": 1, "dialogue": "w01-d04", "sl": "Delam doma.", "en": "I work at home.", "speaker": "m", "chunks": [],
      "new_words": [ { "sl": "doma", "en": "at home", "tag": "cognate", "note": null } ],
      "grammar_note": null },
    { "id": "w01-d04-s10", "week": 1, "dialogue": "w01-d04", "sl": "Imate lepo družino.", "en": "You have a lovely family.", "hint": "formal", "speaker": "f", "chunks": ["lepo družino", "Imate lepo družino."],
      "new_words": [ { "sl": "družina", "en": "family", "tag": "false_friend", "note": "družina is family." } ],
      "grammar_note": "False friend: {družina} means family." },

    { "id": "w01-d05-s01", "week": 1, "dialogue": "w01-d05", "sl": "Koliko je ura?", "en": "What time is it?", "speaker": "f", "chunks": ["je ura", "Koliko je ura?"],
      "new_words": [ { "sl": "ura", "en": "hour, clock", "tag": "german_loan", "note": null } ],
      "grammar_note": "{ura} is both hour and clock, like the German word. Literally 'how much is the hour'." },
    { "id": "w01-d05-s02", "week": 1, "dialogue": "w01-d05", "sl": "Ura je tri.", "en": "It's three o'clock.", "speaker": "m", "chunks": [],
      "new_words": [], "grammar_note": null },
    { "id": "w01-d05-s03", "week": 1, "dialogue": "w01-d05", "sl": "Imaš danes čas?", "en": "Do you have time today?", "hint": "informal", "speaker": "m", "chunks": ["danes čas", "Imaš danes čas?"],
      "new_words": [ { "sl": "čas", "en": "time", "tag": "false_friend", "note": "čas is time in general, not an hour. An hour is ura." } ],
      "grammar_note": "False friend: {čas} is time in general, not an hour. An hour is {ura}." },
    { "id": "w01-d05-s04", "week": 1, "dialogue": "w01-d05", "sl": "Danes nimam časa.", "en": "Today I don't have time.", "speaker": "f", "chunks": ["nimam časa", "Danes nimam časa."],
      "new_words": [],
      "grammar_note": "Genitive after {nimam}: {čas} becomes {časa}." },
    { "id": "w01-d05-s05", "week": 1, "dialogue": "w01-d05", "sl": "Kaj pa jutri?", "en": "And what about tomorrow?", "speaker": "m", "chunks": [],
      "new_words": [ { "sl": "jutri", "en": "tomorrow", "tag": "new", "note": null } ],
      "grammar_note": null },
    { "id": "w01-d05-s06", "week": 1, "dialogue": "w01-d05", "sl": "Jutri imam čas.", "en": "Tomorrow I have time.", "speaker": "f", "chunks": [],
      "new_words": [], "grammar_note": null },
